# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pm_db

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Procore API (Optional)
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_REDIRECT_URI=

# Ollama API (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
